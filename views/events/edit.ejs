<%- include('../partials/header') %>
<div class="form-page">
  <div class="form-card" style="max-width: 520px;">
    <p class="eyebrow">Editar</p>
    <h1><%= event.title %></h1>
    <form action="/events/<%= event.id %>?_method=PUT" method="POST" class="form">
      <label>Título
        <input type="text" name="title" value="<%= event.title %>" required autofocus>
      </label>
      <label>Descrição
        <textarea name="description" rows="4"><%= event.description || '' %></textarea>
      </label>
      <div class="form-row">
        <label>Data e hora
          <input type="datetime-local" name="eventDate" value="<%= new Date(event.event_date).toISOString().slice(0, 16) %>" required>
        </label>
        <label>Capacidade
          <input type="number" name="capacity" min="0" value="<%= event.capacity %>">
        </label>
      </div>
      <label>Local
        <input type="text" name="location" value="<%= event.location || '' %>">
      </label>
      <button type="submit" class="btn btn--primary btn--block">Salvar alterações</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
