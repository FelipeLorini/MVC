<%- include('../partials/header') %>
<section class="page-header">
  <div>
    <p class="eyebrow">Catálogo</p>
    <h1>Eventos</h1>
    <p class="page-header__lead">Descubra o que está rolando e garanta sua vaga.</p>
  </div>
  <% if (currentUser && currentUser.role === 'organizador') { %>
    <a href="/events/new" class="btn btn--primary">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo evento
    </a>
  <% } %>
</section>

<% if (events.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__icon">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </p>
    <h3>Nenhum evento por aqui ainda</h3>
    <p>Assim que um organizador publicar um evento, ele aparece nesta lista.</p>
    <% if (currentUser && currentUser.role === 'organizador') { %>
      <a href="/events/new" class="btn btn--primary">Criar o primeiro evento</a>
    <% } else if (!currentUser) { %>
      <a href="/auth/register" class="btn btn--primary">Criar conta de organizador</a>
    <% } %>
  </div>
<% } else { %>
  <div class="ticket-grid">
    <% events.forEach((event) => { %>
      <%- include('_card', { event }) %>
    <% }) %>
  </div>
<% } %>
<%- include('../partials/footer') %>
